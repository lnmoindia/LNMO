{
  "expo": {
    "name": "LNMO",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lnmo",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lnmo.app",
      "associatedDomains": [
        "applinks:lnmo-fees.preview.emergentagent.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Take a photo of your fee payment receipt",
        "NSPhotoLibraryUsageDescription": "Attach payment screenshots and photos to messages"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.lnmo.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "lnmo-fees.preview.emergentagent.com",
              "pathPrefix": "/login"
            },
            {
              "scheme": "https",
              "host": "lnmo-fees.preview.emergentagent.com",
              "pathPrefix": "/setup/parent"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach payment screenshots and photos to messages",
          "cameraPermission": "Take a photo of your fee payment receipt"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#3F6B8A",
          "defaultChannel": "school"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
